# Copia a .env y ajusta. NUNCA comitees el .env (está en .gitignore).
DATABASE_URL=postgresql+asyncpg://star4cast:star4cast@db:5432/star4cast

# OBLIGATORIO: secreto largo y aleatorio. La app no arranca sin él.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:4200,http://localhost:8080
DEBUG=false

# --- Sembrado inicial ---
# Si SEED_DEMO_DATA=true, las 4 credenciales de abajo son OBLIGATORIAS.
SEED_DEMO_DATA=true
DEMO_EMAIL=demo@star4cast.com
DEMO_PASSWORD=cambia-esta-contrasena
ADMIN_EMAIL=admin@star4cast.com
ADMIN_PASSWORD=cambia-esta-contrasena
