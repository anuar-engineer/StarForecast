# Variables de PRODUCCIÓN para docker-compose.yml.
# Copia este archivo a .env (está en .gitignore) y rellena los valores.
# Genera secretos largos con:  openssl rand -base64 48

# Base de datos
POSTGRES_PASSWORD=

# Firma de los tokens de sesión (JWT). Si cambia, se cierran todas las sesiones.
JWT_SECRET=

# Administrador de la plataforma (se crea en el primer arranque si no existe).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Correo saliente (hola@star4cast.es). Sin SMTP_PASSWORD no se envían avisos.
SMTP_PASSWORD=

SMTP_HOST=smtp.serviciodecorreo.es
SMTP_PORT=465
SMTP_USER=hola@star4cast.es
MAIL_FROM=hola@star4cast.es
LEAD_NOTIFY_TO=hola@star4cast.es

# Dominio
CORS_ORIGINS=https://star4cast.es

# Datos de demo (producción: false; docker-compose.dev.yml lo fuerza a true)
SEED_DEMO_DATA=false
DEMO_EMAIL=demo@star4cast.es
DEMO_PASSWORD=
